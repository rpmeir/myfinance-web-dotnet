@{
    ViewBag.Title = "Transações";
}

<h1>@ViewBag.Title</h1>

<button type="button" class="btn btn-block btn-primary mb-3" onclick="Novo()">Criar item de Transação</button>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Id</th>
            <th>Historico</th>
            <th>Tipo</th>
            <th>Valor</th>
            <th>Data</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in (List<TransacaoModel>)ViewBag.TransacaoList)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Historico</td>
                <td>@item.Tipo</td>
                <td>@item.Valor</td>
                <td>@item.Data.ToString("dd/MM/yyyy")</td>
                <td>
                    <button type="button" class="btn btn-sm btn-warning" onclick="Atualizar(@item.Id)">Editar</button>
                    <button type="button" class="btn btn-sm btn-danger" onclick="Excluir(@item.Id)">Excluir</button>
                </td>
            </tr>
        }
        <!-- Table rows will go here -->
    </tbody>
</table>

@section Scripts {
    <script src="~/js/Transacao/Index.js" asp-append-version="true"></script>
}