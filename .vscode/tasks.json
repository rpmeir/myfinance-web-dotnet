{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "clean",
      "type": "process",
      "command": "dotnet",
      "args": [
        "clean",
        "${workspaceFolder}/MyFinanceWeb.Mvc/MyFinanceWeb.Mvc.csproj"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "build",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/MyFinanceWeb.Mvc/MyFinanceWeb.Mvc.csproj"
      ],
      "problemMatcher": "$msCompile",
      "dependsOn": [
        "clean"
      ],
      "dependsOrder": "sequence",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "publish",
      "type": "process",
      "command": "dotnet",
      "args": [
        "publish",
        "${workspaceFolder}/MyFinanceWeb.Mvc/MyFinanceWeb.Mvc.csproj",
        "--configuration",
        "Release",
        "--output",
        "${workspaceFolder}/MyFinanceWeb.Mvc/bin/Release/net8.0/publish"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "run",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/MyFinanceWeb.Mvc/MyFinanceWeb.Mvc.csproj",
        "--launch-profile",
        "https"
      ],
      "isBackground": true,
      "problemMatcher": {
        "owner": "aspnet",
        "pattern": {
          "regexp": ".*"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Now listening on:",
          "endsPattern": "Now listening on:"
        }
      }
    }
  ]
}